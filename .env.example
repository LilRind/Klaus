# ============================================================================
# HelloAgents-TS 统一环境变量配置（对应书 7.1.3 节 .env.example）
# 复制此文件为 .env 并填入你的 API 密钥（.env 已被 .gitignore 忽略）
# ============================================================================

# —— 统一配置（推荐）：框架根据这些值自动检测 provider ——

# 模型名称（例如 gpt-4o-mini / deepseek-chat / glm-4-flash / Qwen/Qwen2.5-72B-Instruct）
LLM_MODEL_ID=your-model-name

# API 密钥
LLM_API_KEY=your-api-key-here

# 服务地址（OpenAI 兼容端点，智谱示例：https://open.bigmodel.cn/api/paas/v4）
LLM_BASE_URL=https://api.openai.com/v1

# 超时时间（毫秒，可选，默认 60000）
LLM_TIMEOUT=60000

# ============ 对齐装配（examples/alignment）可选配置 ============
# 装包类命令（npm/pip/yarn/pnpm install 等）权限策略：
#   allow（默认）= 自动安装不询问；ask = 弹 y/N 人工审批
# PACKAGE_INSTALL_POLICY=ask

# —— 按提供商单独配置（可选）：只设其中之一即可被自动检测 ——

# MODELSCOPE_API_KEY=ms-your_key
# DEEPSEEK_API_KEY=sk-your_key
# ZHIPU_API_KEY=your_key
# SILICONFLOW_API_KEY=sk-your_key
# OPENAI_API_KEY=sk-your_key
# OLLAMA_HOST=http://localhost:11434

# ============================================================================
# 第八章扩展：记忆与 RAG（对应书 8.1.4 的 .env.example）
# ============================================================================
# 不配置 EMBED_* 时自动退回 TFIDF 嵌入（零网络，检索质量降级但可离线跑通）

# —— 嵌入（Embedding）配置 ——
# tfidf（默认，离线兜底）| dashscope | openai | ollama | custom（OpenAI 兼容端点）
# EMBED_MODEL_TYPE=dashscope
# EMBED_MODEL_NAME=text-embedding-v3
# EMBED_API_KEY=sk-your_key
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# —— Qdrant 向量数据库（情景/语义/感知记忆与 RAG 检索）——
# 留空时使用进程内内存向量库（重启即失）；接真实 Qdrant 见 README 第八章说明
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=hello_agents_vectors
# ⚠️ 必须与嵌入模型输出维度一致：TFIDF=512，MiniLM=384，dashscope v3=1024
# QDRANT_VECTOR_SIZE=1024

# —— Neo4j 图数据库（语义记忆知识图谱）——
# 留空时使用进程内内存图库
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=hello-agents-password

# —— Rerank 精排（可选增强，默认关闭）——
# 配置后 RAGTool 自动装配；调用时传 enable_rerank: true 才生效
# RERANK_MODEL_NAME=qwen3.7-text-rerank
# RERANK_API_KEY=（缺省时回落 EMBED_API_KEY / LLM_API_KEY）
